{
  "rewrites": [
    {
      "source": "/",
      "destination": "/accueil.html"
    },
    {
      "source": "/5-essentiels",
      "destination": "/assets/Les%205%20Essentiels_The%205%20Essentials_Los%205%20Esenciales.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "exec-ia.com"
        }
      ],
      "destination": "https://exec-ia.ai/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.exec-ia.com"
        }
      ],
      "destination": "https://exec-ia.ai/:path*",
      "permanent": true
    },
    {
      "source": "/expertise.html",
      "destination": "/offres.html#expertise-strategique",
      "permanent": true
    },
    {
      "source": "/expertise-en.html",
      "destination": "/offres-en.html#expertise-strategique",
      "permanent": true
    },
    {
      "source": "/expertise-es.html",
      "destination": "/offres-es.html#expertise-strategique",
      "permanent": true
    },
    {
      "source": "/expertise",
      "destination": "/offres.html#expertise-strategique",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/robot",
      "destination": "/perspective-robots-humanoides-token-tax.html#mini-diagnostic",
      "permanent": false
    },
    {
      "source": "/robot-en",
      "destination": "/perspective-robots-humanoides-token-tax-en.html#mini-diagnostic",
      "permanent": false
    },
    {
      "source": "/robot-es",
      "destination": "/perspective-robots-humanoides-token-tax-es.html#mini-diagnostic",
      "permanent": false
    },
    {
      "source": "/articles.html",
      "destination": "/perspectives.html",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/perspectives.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js-eu1.hs-scripts.com https://js-eu1.hs-banner.com https://js-eu1.hs-analytics.net https://js-eu1.hscollectedforms.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://track-eu1.hubspot.com https://forms-eu1.hscollectedforms.net https://forms-eu1.hsforms.com; connect-src 'self' https://api-eu1.hubapi.com https://forms-eu1.hscollectedforms.net https://js-eu1.hs-banner.com https://js-eu1.hs-analytics.net https://track-eu1.hubspot.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*).pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
